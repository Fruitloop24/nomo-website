---
import Base from '../layouts/Base.astro'
import BookingForm from '../components/BookingForm'
import { CONFIG } from '../config'
---

<Base
  title="Book a Pickup"
  description="Schedule a junk removal pickup in Middle Georgia. Pick a time that works — we'll come walk the job and lock in your price before we load anything.">
  <!-- Pic leads -->
  <section class="relative bg-black">
    <img src="/photos/home-cleanout.jpg" alt="NoMo Junk dumpster on a driveway" class="w-full h-56 sm:h-72 md:h-96 object-cover" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/20"></div>
    <div class="absolute inset-0 flex items-center justify-center text-center px-4">
      <div>
        <p class="text-accent-light text-xs font-bold tracking-[0.3em] uppercase mb-3 drop-shadow">Free · No-Obligation</p>
        <h1 class="font-heading text-4xl md:text-6xl font-bold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
          Book a Pickup
        </h1>
      </div>
    </div>
  </section>

  <!-- Slim band below -->
  <section class="bg-accent py-6 md:py-8">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="text-white text-base md:text-lg font-semibold leading-relaxed">
        Tell us what needs to go and pick a time — real price on-site, no pressure, no hidden fees.
      </p>
    </div>
  </section>

  <section class="py-10 md:py-14 bg-stone-900">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <BookingForm client:load />
    </div>
  </section>

  <section class="py-12 bg-black border-t border-stone-700 text-center">
    <div class="max-w-xl mx-auto px-4">
      <h2 class="font-heading text-xl md:text-2xl font-bold text-warm-100 mb-2">Rather just talk?</h2>
      <p class="text-warm-300 mb-6 text-sm md:text-base">We answer {CONFIG.bookingApi.hoursLabel}. Call or text us anytime.</p>
      <a
        href={CONFIG.phone.href}
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white px-6 py-3 rounded-xl font-semibold no-underline shadow-md transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        Call {CONFIG.phone.display}
      </a>
    </div>
  </section>
</Base>
