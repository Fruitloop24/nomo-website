---
import Base from '../layouts/Base.astro'
import { CONFIG } from '../config'
---

<Base
  title="Reservation Confirmed"
  description="Your dumpster reservation is confirmed.">
  <section class="bg-black min-h-[70vh] flex items-center justify-center px-4 py-20">
    <div class="max-w-lg w-full bg-white rounded-2xl border border-warm-100 p-8 md:p-10 shadow-sm text-center">
      <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-9 h-9 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>

      <h1 class="font-heading text-3xl md:text-4xl font-bold text-stone-900 mb-3">You're reserved!</h1>
      <p class="text-stone-600 mb-2">
        Payment received — your roll-off is locked in. Stripe just emailed your receipt.
      </p>
      <p class="text-stone-600 mb-8">
        We'll be in touch before drop-off, and you'll get a reminder the day before and an hour ahead.
      </p>

      <div class="bg-warm-50 border border-warm-200 rounded-xl px-5 py-4 mb-8 text-sm text-stone-600">
        Questions about your drop-off? Call or text us at{' '}
        <a href={CONFIG.phone.href} class="text-accent hover:text-accent-dark font-semibold no-underline">{CONFIG.phone.display}</a>.
      </div>

      <a href="/" class="inline-block bg-accent hover:bg-accent-dark text-white px-6 py-3 rounded-xl font-semibold transition-colors no-underline">
        ← Back to home
      </a>
    </div>
  </section>
</Base>
