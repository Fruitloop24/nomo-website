---
import { CONFIG } from '../config'

const year = new Date().getFullYear()
---

<footer class="bg-black text-warm-200 border-t border-stone-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <img
          src={CONFIG.images.logoTransparent}
          alt={CONFIG.appName}
          class="h-16 w-auto object-contain mb-5"
          loading="lazy"
        />
        {
          CONFIG.socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={`NoMo Junk on ${s.name}`}
              class="inline-flex items-center gap-2.5 bg-accent hover:bg-accent-dark text-white px-5 py-3 rounded-xl text-base font-bold no-underline transition-colors mb-5"
            >
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.13 22 16.99 22 12z" />
              </svg>
              Follow us on {s.name}
            </a>
          ))
        }
        <p class="text-warm-300 text-sm leading-relaxed max-w-xs">
          {CONFIG.footer.tagline}
        </p>
      </div>

      <div>
        <h4 class="font-heading text-xs font-semibold text-warm-100 uppercase tracking-[0.25em] mb-5">Quick Links</h4>
        <ul class="space-y-3">
          {
            CONFIG.footer.links.map((link) => (
              <li>
                <a href={link.to} class="text-sm text-warm-300 hover:text-accent-light transition-colors no-underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-xs font-semibold text-warm-100 uppercase tracking-[0.25em] mb-5">Contact Us</h4>
        <ul class="space-y-3 text-sm text-warm-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <a href={CONFIG.phone.href} class="hover:text-accent-light transition-colors no-underline">
              {CONFIG.phone.display}
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <a href={CONFIG.cta.email.href} class="hover:text-accent-light transition-colors no-underline break-all">
              {CONFIG.email}
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <div>
              <div>{CONFIG.address.full}</div>
              <div class="text-warm-400 text-xs">Serving {CONFIG.address.region}</div>
            </div>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <div>{CONFIG.hours.weekday}</div>
              <div class="text-warm-400 text-xs">{CONFIG.hours.weekend}</div>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Areas We Serve -->
    <div class="border-t border-stone-700 mt-12 pt-8">
      <h4 class="font-heading text-xs font-semibold text-warm-100 uppercase tracking-[0.25em] mb-4 text-center">
        Areas We Serve
      </h4>
      <ul class="flex flex-wrap justify-center gap-2">
        {
          CONFIG.areasServed.map((city) => (
            <li class="text-xs text-warm-300 bg-stone-900 border border-stone-700 rounded-full px-3 py-1.5">
              {city}, {CONFIG.address.state}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="border-t border-stone-700 mt-10 pt-8 text-center">
      <p class="text-xs text-warm-400 tracking-wider">
        &copy; {year} {CONFIG.appName} · {CONFIG.website} · All rights reserved.
      </p>
    </div>
  </div>
</footer>
