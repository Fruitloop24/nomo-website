---
import { CONFIG } from '../config'

const items = CONFIG.images.beforeAfters
---

<section class="py-20 md:py-28 bg-stone-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-accent text-xs tracking-[0.3em] uppercase font-bold mb-4">Recent Work</p>
      <h2 class="font-heading text-3xl md:text-5xl font-bold text-warm-100 leading-tight">Before &amp; After</h2>
    </div>

    <div id="ba-carousel" class="max-w-3xl mx-auto">
      <div class="relative h-[360px] sm:h-[480px] md:h-[560px] rounded-2xl overflow-hidden ring-2 ring-accent/40 bg-black shadow-2xl shadow-black/50">
        {
          items.map((p, i) => (
            <figure
              class:list={['ba-slide absolute inset-0 transition-opacity duration-700', i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none']}
              data-i={i}
            >
              <div class="grid grid-cols-2 gap-1.5 md:gap-2 h-full p-1.5 md:p-2">
                <div class="relative rounded-xl overflow-hidden">
                  <img src={p.before} alt={`${p.title} — before`} class="w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
                  <span class="absolute top-3 left-3 bg-black/85 text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-md">Before</span>
                </div>
                <div class="relative rounded-xl overflow-hidden">
                  <img src={p.after} alt={`${p.title} — after`} class="w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
                  <span class="absolute top-3 right-3 bg-accent text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-md shadow-lg shadow-accent/40">After</span>
                </div>
              </div>
              <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 to-transparent pt-12 pb-4 px-5 text-center">
                <p class="text-white font-heading text-lg md:text-2xl font-bold uppercase tracking-wide drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">{p.title}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="flex items-center justify-center gap-2.5 mt-6">
        {
          items.map((_, i) => (
            <button
              type="button"
              class:list={['ba-dot h-2.5 rounded-full transition-all cursor-pointer', i === 0 ? 'w-8 bg-accent' : 'w-2.5 bg-white/30 hover:bg-white/60']}
              data-i={i}
              aria-label={`Show example ${i + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('ba-carousel')
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.ba-slide'))
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.ba-dot'))
    let current = 0
    let timer = 0

    const show = (n: number) => {
      current = (n + slides.length) % slides.length
      slides.forEach((s, k) => {
        s.classList.toggle('opacity-100', k === current)
        s.classList.toggle('opacity-0', k !== current)
        s.classList.toggle('pointer-events-none', k !== current)
      })
      dots.forEach((d, k) => {
        d.classList.toggle('w-8', k === current)
        d.classList.toggle('bg-accent', k === current)
        d.classList.toggle('w-2.5', k !== current)
        d.classList.toggle('bg-white/30', k !== current)
      })
    }

    const start = () => {
      timer = window.setInterval(() => show(current + 1), 3000)
    }
    const stop = () => window.clearInterval(timer)

    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        stop()
        show(k)
        start()
      })
    )

    start()
  }
</script>
