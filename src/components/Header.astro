---
import { CONFIG } from '../config'

const path = Astro.url.pathname
const isActive = (to: string) =>
  to === '/' ? path === '/' : path === to || path.startsWith(to + '/')

const navItems = CONFIG.nav
const fbHref = CONFIG.socials.find((s) => s.name === 'Facebook')?.href ?? CONFIG.socials[0]?.href
---

<header class="fixed top-0 left-0 right-0 z-50 bg-accent border-b-2 border-black shadow-[0_4px_20px_-2px_rgba(30,111,255,0.5)]">
  <!-- Banner: phone (left) · logo (center) · Book (right) -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6">
    <div class="h-[68px] md:h-[84px] flex items-center justify-between gap-3 md:gap-6">
      <a
        href={CONFIG.phone.href}
        class="shrink-0 flex items-center gap-2 text-white hover:text-white/80 no-underline transition-colors"
      >
        <svg class="w-5 h-5 md:w-6 md:h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        <span class="hidden sm:inline font-heading font-bold text-lg md:text-xl tracking-wider leading-none">{CONFIG.phone.display}</span>
      </a>

      <a href="/" class="flex-1 flex justify-center items-center no-underline">
        <span class="bg-black rounded-xl px-3 py-1.5 ring-1 ring-white/15 shadow-lg">
          <img
            src={CONFIG.images.logoTransparent}
            alt={CONFIG.appName}
            class="h-9 sm:h-10 md:h-14 w-auto object-contain"
            loading="eager"
          />
        </span>
      </a>

      <a
        href={CONFIG.booking}
        class="shrink-0 inline-flex items-center gap-1.5 bg-black hover:bg-stone-800 text-white px-3 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-heading font-bold tracking-wider uppercase transition-colors no-underline ring-1 ring-white/20"
      >
        <span class="hidden sm:inline">Book Now</span>
        <span class="sm:hidden">Book</span>
      </a>
    </div>
  </div>

  <!-- Thin nav strip -->
  <nav class="bg-black border-t border-stone-700">
    <div class="max-w-7xl mx-auto px-4">
      <ul class="flex items-center justify-center gap-8 sm:gap-12 md:gap-16 h-9">
        {
          navItems.map(({ to, label }) => (
            <li>
              <a
                href={to}
                class:list={[
                  'font-heading tracking-[0.18em] uppercase text-[11px] sm:text-xs transition-colors no-underline py-2',
                  isActive(to)
                    ? 'text-accent border-b border-accent'
                    : 'text-warm-300 hover:text-accent-light',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
        {fbHref && (
          <li>
            <a href={fbHref} target="_blank" rel="noopener" aria-label="NoMo Junk on Facebook" class="flex items-center text-warm-300 hover:text-accent-light transition-colors no-underline py-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.13 22 16.99 22 12z" />
              </svg>
            </a>
          </li>
        )}
      </ul>
    </div>
  </nav>
</header>
