---
import { CONFIG } from '../config'

const path = Astro.url.pathname
const isActive = (to: string) =>
  to === '/' ? path === '/' : path === to || path.startsWith(to + '/')

type NavItem = { to: string; label: string; iconKey: 'home' | 'rent' | 'about' | 'call' }

const items: NavItem[] = [
  { to: '/', label: 'Home', iconKey: 'home' },
  { to: '/rent', label: 'Rent', iconKey: 'rent' },
  { to: '/about', label: 'About', iconKey: 'about' },
  { to: CONFIG.phone.href, label: 'Call', iconKey: 'call' },
]

const icons = {
  home: 'M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25',
  // dumpster-ish icon: trapezoid bucket
  rent: 'M3.75 8.25h16.5L18 19.5H6L3.75 8.25zM3 8.25l1.5-3h15L21 8.25M9 12.75h6',
  about:
    'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z',
  call: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z',
}
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-stone-900/95 backdrop-blur-sm border-t border-stone-700 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.4)]">
  <div class="flex items-stretch h-16">
    {
      items.map(({ to, label, iconKey }) => {
        const external = to.startsWith('tel:') || to.startsWith('mailto:')
        const active = !external && isActive(to)
        return (
          <a
            href={to}
            class:list={[
              'flex-1 flex flex-col items-center justify-center gap-1 transition-colors no-underline',
              active ? 'text-accent' : 'text-warm-300 hover:text-accent-light',
            ]}
          >
            <span class="h-6 flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[iconKey]} />
              </svg>
            </span>
            <span class="text-[10px] font-medium leading-none">{label}</span>
          </a>
        )
      })
    }
  </div>
</nav>
